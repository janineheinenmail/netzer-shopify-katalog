# Vorlage fuer die nicht geheimen Umgebungsvariablen der Codex-Cloud-Umgebung.
# Keine lokale `.env`-Datei ist fuer den Cloud-Ablauf erforderlich.
# Die tatsaechliche kanonische *.myshopify.com-Domain erst nach Bestaetigung
# eintragen (ohne https://); keinen Shopnamen ableiten oder erraten.
SHOPIFY_SHOP_DOMAIN=netzer-dental.myshopify.com

# Muss exakt zur von Shopify gemeldeten myshopifyDomain passen.
SHOPIFY_EXPECTED_SHOP_DOMAIN=netzer-dental.myshopify.com

# Erwartete oeffentliche Primaerdomain. Der Identitaetscheck erwartet exakt
# netzer-dental.de.
SHOPIFY_EXPECTED_PRIMARY_DOMAIN=netzer-dental.de

# Explizit eine von der installierten App unterstuetzte Admin-API-Version setzen.
SHOPIFY_API_VERSION=YYYY-MM

# Geheim und deshalb NICHT hier eintragen: SHOPIFY_CLIENT_ID und
# SHOPIFY_CLIENT_SECRET gehoeren in den geschuetzten Secrets-Bereich von Codex
# Cloud. Ein kurzlebiges Admin-API-Token wird im Setup nur im Arbeitsspeicher
# erzeugt und weder als Umgebungsvariable noch als Datei gespeichert.
